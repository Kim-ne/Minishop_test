      "name": "Auth",
      "item": [
        {
          "name": "Login Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (response.success && response.data && response.data.token) {\r",
                  "    pm.environment.set('token', response.data.token);\r",
                  "    console.log('✅ Token saved:', response.data.token.substring(0, 20) + '...');\r",
                  "} else {\r",
                  "    console.log('❌ Login failed - token not saved');\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "2|AKIjT7FhtVn75li3z8L6F0aiI9RaLNLtAKUcO8w2bb3e1179",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"q@gmail.com\",\r\n    \"password\": \"Kim080894\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login and get Bearer Token.\n\nToken wil be save in environment variable \\`{{token}}\\`  \nafter login success.\n\n**No auth needed** — public endpoint.EndFragment"
          },
          "response": []
